---
// Deck variant of the component catalogue: the ```mdx deck fence of `COMPONENTS.md`, rendered as
// a real deck. A deck takes the whole window, so the catalogue page embeds it in an iframe.
import DeckLayout from "~/layouts/DeckLayout.astro";
import { catalogDeck } from "~/lib/component-catalog";

const Deck = await catalogDeck();
---

<DeckLayout title="Composants · deck">
  {Deck && <Deck />}
</DeckLayout>
