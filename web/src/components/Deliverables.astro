---
type IconKey =
  | 'clipboard'
  | 'git-branch'
  | 'layers'
  | 'bar-chart'
  | 'figma'
  | 'layout'
  | 'users'
  | 'code'
  | 'check-square'
  | 'map'
  | 'cpu'
  | 'search'

interface Livrable {
  icon: IconKey
  title: string
  description: string
  days?: number
  price?: string
}

interface Props {
  items: Livrable[]
  title?: string
  total?: { days: number; price: string }
}

const { items, title, total } = Astro.props

const paths: Record<IconKey, string> = {
  'clipboard':    '<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/>',
  'git-branch':   '<line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
  'layers':       '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
  'bar-chart':    '<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="3" y1="20" x2="21" y2="20"/>',
  'figma':        '<path d="M5 5.5A3.5 3.5 0 0 1 8.5 2H12v7H8.5A3.5 3.5 0 0 1 5 5.5z"/><path d="M12 2h3.5a3.5 3.5 0 1 1 0 7H12V2z"/><path d="M12 12.5a3.5 3.5 0 1 1 7 0 3.5 3.5 0 1 1-7 0z"/><path d="M5 19.5A3.5 3.5 0 0 1 8.5 16H12v3.5a3.5 3.5 0 1 1-7 0z"/><path d="M5 12.5A3.5 3.5 0 0 1 8.5 9H12v7H8.5A3.5 3.5 0 0 1 5 12.5z"/>',
  'layout':       '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>',
  'users':        '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  'code':         '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  'check-square': '<polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  'map':          '<polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/>',
  'cpu':          '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>',
  'search':       '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
}
---

<div class="my-6 space-y-2">
  {title && (
    <div class="flex items-center gap-3 border-b border-border pb-2.5">
      <span class="rounded-[3px] bg-brand px-2 py-1 text-[0.65rem] leading-none font-semibold tracking-[0.1em] text-surface uppercase">
        Deliverables
      </span>
      {title && <span class="text-[0.78rem] font-medium text-ink-soft">{title}</span>}
    </div>
  )}
  <div class="grid grid-cols-2 gap-2">
    {items.map((item, index) => (
      <div class="flex gap-3 p-4 border border-zinc-200 rounded-lg bg-white relative">
        <div class="absolute top-2.5 right-2.5 text-[10px] font-medium text-zinc-300 tabular-nums">
          {String(index + 1).padStart(2, '0')}
        </div>
        <div class="w-9 h-9 flex items-center justify-center rounded-md bg-zinc-100 text-zinc-500 shrink-0 mt-0.5">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={paths[item.icon]}
          />
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-start justify-between gap-2 mb-1">
            <span class="text-sm font-medium leading-snug text-ink">{item.title}</span>
            {item.days && (
              <span class="text-[11px] font-medium text-zinc-400 bg-zinc-100 border border-zinc-200 rounded px-1.5 py-0.5 tabular-nums whitespace-nowrap shrink-0 mt-px">
                {item.days} JH
              </span>
            )}
          </div>
          <p class="text-[13px] text-zinc-500 leading-relaxed m-0">{item.description}</p>
          {item.price && (
            <p class="text-[12px] font-semibold text-zinc-700 mt-1.5 mb-0">{item.price}</p>
          )}
        </div>
      </div>
    ))}
  </div>

  {total && (
    <div class="flex items-center justify-between px-4 py-2.5 bg-zinc-900 text-white rounded-lg text-sm font-semibold">
      <span class="text-zinc-400 font-medium">Total</span>
      <div class="flex gap-5 tabular-nums">
        <span>{total.days} JH</span>
        <span class="text-brand">{total.price}</span>
      </div>
    </div>
  )}
</div>

