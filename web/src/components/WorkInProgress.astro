---
interface Props {
  title: string
  role?: string
}
const { title, role } = Astro.props
---

<div class="wip-block">
  <div class="wip-header">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    <span class="wip-label">À COMPLÉTER</span>
    <span class="wip-title">{title}</span>
    {role && <span class="wip-role">{role}</span>}
  </div>
  <div class="wip-body">
    <slot />
  </div>
</div>

<style>
  .wip-block {
    margin: 1.4em 0;
    border: 1.5px dashed var(--color-brand);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-brand-wash);
  }

  .wip-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    background: var(--color-brand-soft);
    border-bottom: 1.5px dashed var(--color-brand);
    color: var(--color-brand-ink);
  }

  .wip-label {
    font-size: 0.72em;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-ink);
    flex-shrink: 0;
  }

  .wip-title {
    font-size: 0.82em;
    font-weight: 600;
    color: var(--color-brand-ink);
    flex: 1;
  }

  .wip-role {
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-surface);
    background: var(--color-brand-ink);
    padding: 2px 8px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .wip-body {
    padding: 12px 16px;
  }

  .wip-body :global(p) {
    font-size: 0.87em;
    color: var(--color-brand-ink);
    margin-bottom: 0.6em;
    line-height: 1.55;
  }
  .wip-body :global(p:last-child) { margin-bottom: 0; }

  .wip-body :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .wip-body :global(li) {
    position: relative;
    padding: 0.3rem 0 0.3rem 1.4rem;
    font-size: 0.87em;
    color: var(--color-brand-ink);
    border-bottom: 1px solid var(--color-brand-line);
    line-height: 1.5;
    margin: 0;
  }
  .wip-body :global(li:last-child) { border-bottom: none; }
  .wip-body :global(li::before) {
    content: '?';
    position: absolute;
    left: 0;
    top: 0.35rem;
    font-weight: 800;
    font-size: 0.8em;
    color: var(--color-brand-ink);
  }

  .wip-body :global(strong) { color: var(--color-brand-ink); font-weight: 700; }
  .wip-body :global(code) {
    font-size: 0.82em;
    background: var(--color-brand-line);
    color: var(--color-brand-ink);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }
</style>
