---
// A grid of short tiles, each a label and a value. For a technical stack, a set
// of monthly volumes or the conditions that close a slide.
interface Props {
  cols?: 2 | 3 | 4;
  /** Fill the remaining height instead of sitting at its natural size. */
  fill?: boolean;
}
const { cols = 3, fill = false } = Astro.props;
---
<div class:list={["tiles", `cols-${cols}`, { fill }]}><slot /></div>
