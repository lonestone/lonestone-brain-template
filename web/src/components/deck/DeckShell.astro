---
// Wrapper of every MDX deck: the 1920 × 1080 stage scaled to the screen, with
// keyboard (arrows, Page Up/Down, Space, Home/End) and touch navigation,
// fullscreen, speaker notes and print. `label` is repeated in the chrome bar
// of each slide, typically "Company × Recipient".
//
// Outside fullscreen, a rail on the left lists the slides as thumbnails: the
// slot is rendered twice, so thumbnails are real slides (Mermaid included),
// scaled down. The current slide lives in the URL hash (`#3`). `width` and
// `height` are read by the skill "print-doc" to size the PDF.
interface Props {
  label: string;
}
const { label } = Astro.props;

const WIDTH = 1920;
const HEIGHT = 1080;
const slides = await Astro.slots.render("default");
const button =
  "inline-flex h-7 min-w-7 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent px-2 text-inherit opacity-70 hover:bg-white/10 hover:opacity-100";
---
<deck-stage
  width={WIDTH}
  height={HEIGHT}
  style={`--deck-label: ${JSON.stringify(label)}`}
  class="fixed inset-0 flex overflow-hidden print:static print:block print:overflow-visible"
>
  <nav class="deck-rail w-64 flex-none overflow-x-hidden overflow-y-auto scheme-dark border-r border-white/10 py-4 max-sm:hidden print:hidden" aria-label="Slides">
    <Fragment set:html={slides} />
  </nav>
  <div class="deck-viewport relative flex min-w-0 flex-1 items-center justify-center overflow-hidden print:static print:block print:overflow-visible">
  <div
    class="deck-canvas relative flex-none origin-center print:transform-none!"
    style={`width: ${WIDTH}px; height: ${HEIGHT}px`}
  >
    <Fragment set:html={slides} />
  </div>
  <div
    class="deck-controls absolute bottom-5 left-1/2 flex -translate-x-1/2 items-center gap-1 rounded-full bg-black p-1 text-micro text-white tabular-nums opacity-0 transition-opacity duration-300 select-none data-visible:opacity-100 print:hidden"
    role="toolbar"
    aria-label="Navigation du deck"
  >
    <button type="button" class={button} data-action="prev" aria-label="Slide précédente" title="Précédente (←)">
      <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg>
    </button>
    <span class="px-1" aria-live="polite"><span data-current>1</span> / <span data-total>1</span></span>
    <button type="button" class={button} data-action="next" aria-label="Slide suivante" title="Suivante (→)">
      <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
    </button>
    <button type="button" class={button} data-action="notes" title="Notes de l'orateur (N)">Notes</button>
    <button type="button" class={button} data-action="fullscreen" title="Plein écran (F)">Plein écran</button>
  </div>
  <div
    class="deck-notes absolute inset-x-6 bottom-16 mx-auto max-w-3xl rounded-lg bg-black/85 px-6 py-4 text-lead whitespace-pre-line text-white print:hidden"
    hidden
  >
  </div>
  </div>
</deck-stage>

<!-- Inline, not bundled: an @page in a stylesheet would reach every page of
     the site. This one only ships with the pages that hold a deck, and sets
     the default page so the print dialog prints one slide per sheet. -->
<style is:inline set:html={`@media print { @page { size: ${WIDTH}px ${HEIGHT}px; margin: 0; } }`}></style>

<script>
  const IDLE_MS = 1800;
  // Slide content that keeps a tap instead of turning it into navigation.
  const INTERACTIVE =
    "a[href], button, input, select, textarea, summary, label, video[controls], audio[controls], [role='button'], [tabindex]:not([tabindex^='-'])";

  class DeckStage extends HTMLElement {
    private slides: HTMLElement[] = [];
    private thumbs: HTMLElement[] = [];
    private index = 0;
    private rail!: HTMLElement;
    private viewport!: HTMLElement;
    private canvas!: HTMLElement;
    private controls!: HTMLElement;
    private notes!: HTMLElement;
    private showNotes = false;
    private hideTimer = 0;
    private abort?: AbortController;

    connectedCallback() {
      this.rail = this.querySelector(".deck-rail")!;
      this.viewport = this.querySelector(".deck-viewport")!;
      this.canvas = this.querySelector(".deck-canvas")!;
      this.controls = this.querySelector(".deck-controls")!;
      this.notes = this.querySelector(".deck-notes")!;
      this.slides = [...this.canvas.querySelectorAll<HTMLElement>(":scope > section.slide")];
      this.querySelector("[data-total]")!.textContent = String(this.slides.length);
      this.buildRail();
      this.syncRail();

      this.abort = new AbortController();
      const { signal } = this.abort;
      window.addEventListener("resize", () => this.fit(), { signal });
      window.addEventListener("keydown", (e) => this.onKey(e), { signal });
      window.addEventListener("hashchange", () => this.go(this.hashIndex()), { signal });
      window.addEventListener("mousemove", () => this.flash(), { signal });
      document.addEventListener("fullscreenchange", () => this.syncRail(), { signal });
      this.viewport.addEventListener("click", (e) => this.onTap(e), { signal });
      this.rail.addEventListener("click", (e) => this.onThumb(e), { signal });
      this.controls.addEventListener("click", (e) => this.onControl(e), { signal });

      this.go(this.hashIndex());
      this.fit();
    }

    disconnectedCallback() {
      this.abort?.abort();
    }

    // Wraps each slide copy of the rail in a numbered button.
    private buildRail() {
      this.thumbs = [...this.rail.querySelectorAll<HTMLElement>(":scope > section.slide")].map((slide, i) => {
        const thumb = document.createElement("button");
        thumb.type = "button";
        thumb.dataset.index = String(i);
        thumb.className = "deck-thumb group flex w-full cursor-pointer items-start gap-2 border-0 bg-transparent px-3 py-1.5 text-left";
        thumb.setAttribute("aria-label", `Slide ${i + 1}`);
        thumb.innerHTML = `<span class="w-5 flex-none pt-0.5 text-right text-micro text-white/50 tabular-nums group-data-active:text-white">${i + 1}</span><span class="deck-thumb-frame relative block aspect-video w-48 flex-none overflow-hidden rounded-sm ring-1 ring-white/15 outline-2 outline-offset-2 outline-transparent group-hover:outline-white/30 group-data-active:outline-(--deck-accent)"></span>`;
        slide.inert = true;
        slide.removeAttribute("id");
        thumb.querySelector(".deck-thumb-frame")!.append(slide);
        this.rail.append(thumb);
        return thumb;
      });
    }

    // The rail shows outside fullscreen.
    private syncRail() {
      this.rail.hidden = document.fullscreenElement !== null;
      this.fit();
    }

    private hashIndex() {
      const n = parseInt(location.hash.slice(1), 10);
      return Number.isNaN(n) ? 0 : n - 1;
    }

    private go(i: number) {
      if (!this.slides.length) return;
      this.index = Math.max(0, Math.min(this.slides.length - 1, i));
      this.slides.forEach((slide, j) => slide.toggleAttribute("data-active", j === this.index));
      this.thumbs.forEach((thumb, j) => thumb.toggleAttribute("data-active", j === this.index));
      this.thumbs[this.index]?.scrollIntoView({ block: "nearest" });
      this.querySelector("[data-current]")!.textContent = String(this.index + 1);
      history.replaceState(null, "", `${location.pathname}${location.search}#${this.index + 1}`);
      this.renderNotes();
    }

    private fit() {
      const { clientWidth, clientHeight } = this.viewport;
      const scale = Math.min(clientWidth / this.canvas.offsetWidth, clientHeight / this.canvas.offsetHeight);
      this.canvas.style.transform = `scale(${scale})`;
    }

    // Only a mouse move reveals the controls: the keyboard leaves the slide clean.
    private flash() {
      this.controls.toggleAttribute("data-visible", true);
      clearTimeout(this.hideTimer);
      this.hideTimer = window.setTimeout(() => this.controls.removeAttribute("data-visible"), IDLE_MS);
    }

    private renderNotes() {
      const text = this.slides[this.index]?.dataset.speakerNotes ?? "";
      this.notes.textContent = text || "Pas de notes pour cette slide.";
      this.notes.hidden = !this.showNotes;
    }

    private toggleFullscreen() {
      if (document.fullscreenElement) document.exitFullscreen();
      else document.documentElement.requestFullscreen();
    }

    private onKey(e: KeyboardEvent) {
      const target = e.target as HTMLElement | null;
      if (target?.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target?.tagName ?? "")) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;

      switch (e.key) {
        case "ArrowRight":
        case "ArrowDown":
        case "PageDown":
        case " ":
          this.go(this.index + 1);
          break;
        case "ArrowLeft":
        case "ArrowUp":
        case "PageUp":
          this.go(this.index - 1);
          break;
        case "Home":
          this.go(0);
          break;
        case "End":
          this.go(this.slides.length - 1);
          break;
        case "f":
        case "F":
          this.toggleFullscreen();
          break;
        case "n":
        case "N":
          this.showNotes = !this.showNotes;
          this.renderNotes();
          break;
        default:
          return;
      }
      e.preventDefault();
    }

    private onControl(e: MouseEvent) {
      e.stopPropagation();
      const action = (e.target as HTMLElement).closest<HTMLElement>("[data-action]")?.dataset.action;
      if (action === "prev") this.go(this.index - 1);
      else if (action === "next") this.go(this.index + 1);
      else if (action === "fullscreen") this.toggleFullscreen();
      else if (action === "notes") {
        this.showNotes = !this.showNotes;
        this.renderNotes();
      }
    }

    // On touch screens, a tap on the left or right half of the stage steps
    // back or forward.
    private onTap(e: MouseEvent) {
      if (!matchMedia("(pointer: coarse)").matches) return;
      if ((e.target as HTMLElement).closest(INTERACTIVE)) return;
      const { left, width } = this.viewport.getBoundingClientRect();
      this.go(this.index + (e.clientX < left + width / 2 ? -1 : 1));
    }

    private onThumb(e: MouseEvent) {
      const thumb = (e.target as HTMLElement).closest<HTMLElement>(".deck-thumb");
      if (thumb) this.go(Number(thumb.dataset.index));
    }
  }

  customElements.define("deck-stage", DeckStage);
</script>
