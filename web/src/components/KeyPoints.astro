---
---

<div class="enbref-block">
  <span class="enbref-label">En bref</span>
  <div class="enbref-content">
    <slot />
  </div>
</div>

<style>
  .enbref-block {
    margin: 0.8em 0 1.4em;
    border-radius: 8px;
    border: 1px solid var(--color-brand-line);
    border-top: 3px solid var(--color-brand);
    background: var(--color-brand-wash);
    overflow: hidden;
  }

  .enbref-label {
    display: block;
    padding: 0.35rem 1.2rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-ink);
    background: var(--color-brand-soft);
    border-bottom: 1px solid var(--color-brand-line);
  }

  .enbref-content {
    padding: 0.5rem 1.2rem 0.8rem;
  }

  .enbref-block :global(ul) {
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .enbref-block :global(li) {
    position: relative;
    padding: 0.42rem 0 0.42rem 1.5rem !important;
    margin: 0 !important;
    color: var(--color-ink);
    line-height: 1.45;
    border-bottom: 1px solid var(--color-brand-line);
  }

  .enbref-block :global(li:last-child) {
    border-bottom: none;
    padding-bottom: 0.2rem !important;
  }

  .enbref-block :global(li:first-child) {
    padding-top: 0.35rem !important;
  }

  .enbref-block :global(li::before) {
    content: '→' !important;
    position: absolute;
    left: 0;
    top: 0.5rem;
    font-weight: 700;
    font-size: 0.82em;
    color: var(--color-brand-ink) !important;
  }

  .enbref-block :global(code) {
    font-size: 0.82em;
    background: var(--color-brand-soft);
    color: var(--color-brand-ink);
    padding: 0.1em 0.4em;
    border-radius: 3px;
    border: 1px solid var(--color-brand-line);
  }
</style>
