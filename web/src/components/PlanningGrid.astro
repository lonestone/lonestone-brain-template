---
// PlanningGrid.astro: grid of cards (schedule, scenarios, milestones)
interface Item {
  label: string
  value: string
  note?: string
}
interface Props {
  items: Item[]
}
const { items } = Astro.props
---

<div class="doc-planning">
  {items.map(item => (
    <div class="doc-planning-item">
      <div class="doc-planning-label">{item.label}</div>
      <div class="doc-planning-value">{item.value}</div>
      {item.note && <div class="doc-planning-note">{item.note}</div>}
    </div>
  ))}
</div>

<style>
  .doc-planning {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .doc-planning-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 18px 20px;
  }
  .doc-planning-label {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 8px;
  }
  .doc-planning-label::before {
    content: '';
    flex-shrink: 0;
    margin-top: 3px;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--color-brand);
    transform: rotate(45deg);
  }
  .doc-planning-value {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.35;
  }
  .doc-planning-note {
    font-size: 12.5px;
    color: var(--color-muted);
    margin-top: 5px;
    line-height: 1.5;
  }
  @media (max-width: 700px) {
    .doc-planning { grid-template-columns: 1fr; }
  }
  @media print {
    .doc-planning-item {
      break-inside: avoid;
      page-break-inside: avoid;
    }
  }
</style>
