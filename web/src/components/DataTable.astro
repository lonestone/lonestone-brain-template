---
// Filterable list table for working lists (accounts, documents, leads):
// a search field, one chip per row group, and a framed table whose rows are DataRow.
//
// Chips toggle their group: a click hides its rows, a second click shows them again. They are
// listed in `filters` (label, color, hidden by default), or built from the rows' `group`
// values when only `filter` is given. Each chip shows its row count.
type Column = string | { label: string; align?: "left" | "right" };
type Filter = { value: string; label: string; class?: string; hidden?: boolean };

interface Props {
  columns: Column[];
  /** Label shown before the chips. Alone, it builds one chip per row group. */
  filter?: string;
  /** Explicit chips, in display order. */
  filters?: Filter[];
  searchable?: boolean;
  placeholder?: string;
  empty?: string;
  /** Smaller type, for wide tables of many columns. */
  dense?: boolean;
}
const {
  columns,
  filter,
  filters,
  searchable = true,
  placeholder = "Rechercher…",
  empty = "Aucune ligne ne correspond à ces critères.",
  dense = false,
} = Astro.props;

const cols = columns.map((column) => (typeof column === "string" ? { label: column } : column));
const hasChips = Boolean(filter || filters?.length);
const chipClass = "rounded-full border px-3 py-1 font-medium transition-opacity";
---

<div class="data-table not-prose my-6" data-data-table data-auto-chips={filter && !filters ? "" : undefined}>
  {(searchable || hasChips) && (
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      {hasChips ? (
        <div class="flex flex-wrap items-center gap-1.5 text-micro">
          {filter && <span class="mr-1 text-muted">{filter}</span>}
          <div class="flex flex-wrap gap-1.5" data-chips>
            {filters?.map((chip) => (
              <button
                type="button"
                data-chip={chip.value}
                data-hidden={chip.hidden ? "" : undefined}
                class={`${chipClass} ${chip.class ?? "border-border bg-surface text-ink-soft"} ${chip.hidden ? "opacity-40" : ""}`}
              >
                {chip.label} <span class="tabular-nums opacity-60" data-count></span>
              </button>
            ))}
          </div>
        </div>
      ) : <div />}
      {searchable && (
        <input
          type="search"
          placeholder={placeholder}
          data-search-input
          class="w-60 rounded-lg border border-border bg-surface px-3 py-2 text-small text-ink-soft placeholder:text-faint focus:border-primary/50 focus:outline-none focus:ring-2 focus:ring-primary/10"
        />
      )}
    </div>
  )}
  <div class="overflow-x-auto rounded-xl border border-border bg-surface">
    <table class={`w-full border-collapse ${dense ? "text-micro" : "text-small"}`}>
      <thead>
        <tr class="border-b border-border">
          {cols.map((column) => (
            <th class={`whitespace-nowrap px-4 py-3 align-bottom text-micro font-medium tracking-wide text-muted uppercase ${column.align === "right" ? "text-right" : "text-left"}`}>
              {column.label}
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-border">
        <slot />
      </tbody>
    </table>
    <p class="hidden py-12 text-center text-small text-muted" data-empty>{empty}</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-data-table]").forEach((table) => {
    const rows = [...table.querySelectorAll<HTMLTableRowElement>("tr[data-row]")];
    const input = table.querySelector<HTMLInputElement>("[data-search-input]");
    const chips = table.querySelector<HTMLElement>("[data-chips]");
    const empty = table.querySelector<HTMLElement>("[data-empty]")!;
    const hidden = new Set<string>();

    function apply() {
      const query = input?.value.toLowerCase() ?? "";
      let visible = 0;
      rows.forEach((row) => {
        const show = !hidden.has(row.dataset.group ?? "") && (!query || (row.dataset.search ?? "").includes(query));
        row.style.display = show ? "" : "none";
        if (show) visible++;
      });
      empty.classList.toggle("hidden", visible > 0);
    }

    if (chips && table.hasAttribute("data-auto-chips")) {
      const groups = [...new Set(rows.map((row) => row.dataset.group ?? "").filter(Boolean))].sort().reverse();
      groups.forEach((group) => {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.dataset.chip = group;
        chip.className = "rounded-full border border-border bg-surface px-3 py-1 font-medium text-ink-soft transition-opacity";
        chip.innerHTML = `${group} <span class="tabular-nums opacity-60" data-count></span>`;
        chips.append(chip);
      });
    }

    chips?.querySelectorAll<HTMLButtonElement>("[data-chip]").forEach((chip) => {
      const group = chip.dataset.chip!;
      const count = chip.querySelector<HTMLElement>("[data-count]");
      if (count) count.textContent = String(rows.filter((row) => row.dataset.group === group).length);
      if (chip.hasAttribute("data-hidden")) hidden.add(group);
      chip.addEventListener("click", () => {
        if (hidden.has(group)) hidden.delete(group);
        else hidden.add(group);
        chip.classList.toggle("opacity-40", hidden.has(group));
        apply();
      });
    });

    input?.addEventListener("input", apply);
    apply();
  });
</script>
