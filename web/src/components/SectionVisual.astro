---
import { docImage } from '~/lib/doc-image'
// SectionVisual.astro : Cut-out illustration floating to the right of a section.
// Place it right after a heading so the text wraps around it.
interface Props {
  src: string
  size?: 'sm' | 'md' | 'lg'
}
const { src, size = 'md' } = Astro.props
const heights: Record<string, string> = { sm: 'h-20', md: 'h-[110px]', lg: 'h-[150px]' }
const renderedSrc = await docImage(src, { width: 400 })
---

<div class="section-visu float-none mb-4 clear-right sm:float-right sm:mb-3 sm:ml-6 break-inside-avoid">
  <img
    src={renderedSrc}
    alt=""
    class:list={["block w-auto object-contain drop-shadow-[0_8px_24px_rgba(28,43,74,0.1)]", heights[size]]}
  />
</div>
