---
// HeroStatement.astro: Strong statement on a brand-coloured panel, opening a
// section. The label sits above in small caps.
interface Props {
  label?: string
}
const { label = 'VOTRE ENJEU' } = Astro.props
---

<div class="hero-statement my-8 overflow-hidden rounded-xl bg-brand px-9.5 py-8 text-ink">
  <p class="mt-0 mb-4 text-[0.7em] font-medium tracking-[0.18em] uppercase opacity-55">{label}</p>
  <div class="text-[1.35em] leading-snug font-medium [&_p]:mb-2.5 [&_p:last-child]:mb-0">
    <slot />
  </div>
</div>
