---
import { docImage } from '~/lib/doc-image'
// TeamProfile.astro: one team member on a project, portrait and identity on
// top, role in the project below.
//
// The slot takes a markdown list of relevant experience. Shared portraits live
// in `web/src/assets/personnes/`.
interface Props {
  firstname: string
  name: string
  jobTitle: string
  roleInProject: string
  yearsExperience?: number
  photo?: string
}

const { firstname, name, jobTitle, roleInProject, yearsExperience, photo } = Astro.props
const renderedPhoto = await docImage(photo, { width: 240 })
const label = 'mb-2 text-micro font-bold tracking-[0.12em] text-muted uppercase'
---

<div class="my-5 overflow-hidden rounded-xs border border-border bg-surface print:break-inside-avoid">
  <div class="flex items-start gap-5 px-7 pt-6 pb-5 max-sm:px-4.5 max-sm:pt-4.5 max-sm:pb-4">
    <div class="flex size-22 shrink-0 items-center justify-center overflow-hidden rounded-xs border border-border bg-alt">
      {renderedPhoto ? (
        <img src={renderedPhoto} alt={`${firstname} ${name}`} class="block size-full object-cover object-top" />
      ) : (
        <span class="text-h3 font-medium text-muted uppercase">{firstname[0]}{name[0]}</span>
      )}
    </div>

    <div class="flex flex-col gap-1 pt-1">
      <div class="text-h3 leading-tight font-medium text-ink">{firstname} {name.toUpperCase()}</div>
      <div class="mt-1 text-small font-semibold text-muted">{jobTitle}</div>
      {yearsExperience && <div class="text-micro text-muted">{yearsExperience} ans d'expérience</div>}
    </div>
  </div>

  <div class="mx-7 border-t border-border max-sm:mx-4.5"></div>

  <div class="px-7 py-4.5 max-sm:px-4.5 max-sm:py-3.5">
    <div class={label}>Rôle dans le projet</div>
    <div class="leading-relaxed text-ink-soft">{roleInProject}</div>
    <div class="[&_li]:text-small [&_li]:leading-normal [&_li]:text-ink-soft [&_ul]:mt-2.5 [&_ul]:mb-0">
      <slot />
    </div>
  </div>

</div>
